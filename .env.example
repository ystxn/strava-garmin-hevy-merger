# Copy to .env and fill in. .env is gitignored.
#
# --- Secrets (Kubernetes Secret) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# Any arbitrary string; Strava echoes it back during webhook validation.
STRAVA_WEBHOOK_VERIFY_TOKEN=change-me

# --- Public config (Kubernetes ConfigMap) ---
# Publicly reachable HTTPS base URL of this service (no trailing slash).
PUBLIC_BASE_URL=https://strava-merger.example.com
PENDING_TTL_SECONDS=600
MATCH_WINDOW_SECONDS=300
# everyone | followers_only | only_me  (default only_me keeps merges private)
MERGED_ACTIVITY_VISIBILITY=only_me
# true deletes the Garmin + Hevy originals after a confirmed merge.
DELETE_ORIGINALS=true
# INFO | DEBUG
LOG_LEVEL=INFO

# --- Local development ---
# Set false locally so the service doesn't try to register a Strava webhook
# against an unreachable PUBLIC_BASE_URL.
MANAGE_WEBHOOK_SUBSCRIPTION=true
